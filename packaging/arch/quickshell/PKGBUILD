pkgname=quickshell
_ver=unstable-10-22-2026-9b0f339b
pkgver=${_ver//-/.}
pkgrel=1
_rev=9b0f339b19057f4731bf3b48293307d7ef241671
_patch=0001-feat-add-qml-disk-cache-and-opt-in-render-control-with-partial-damage.patch
pkgdesc='Flexible QtQuick based desktop shell toolkit'
arch=(x86_64 aarch64)
url='https://quickshell.org'
license=('LGPL-3.0-only')
depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'qt6-svg'
  'cli11'
  'cpptrace'
  'jemalloc'
  'wayland'
  'wayland-protocols'
  'libdrm'
  'mesa' # libgbm / egl
  'libxcb'
  'pam'
  'pipewire'
  'glib2'
  'polkit'
)
makedepends=(
  'cmake'
  'ninja'
  'pkgconf'
  'qt6-shadertools'
  'spirv-tools'
  'vulkan-headers'
)
source=(
  "$pkgname-$_rev.tar.gz::https://github.com/quickshell-mirror/quickshell/archive/$_rev.tar.gz"
  "$_patch"
)
sha256sums=(
  '9107ae9179058ea26fafddfc294197fb0865714d227f4c27eaa650fc48537801'
  '29bf1cc2462fb6972f06e10bfbe3c5224586ec9e84a075dcaf465c8ce4ce98b0'
)

prepare() {
  patch -d "$pkgname-$_rev" -Np1 -i "$srcdir/$_patch"
}

build() {
  cmake -B build -S "$pkgname-$_rev" -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DDISTRIBUTOR="archInstall" \
    -DINSTALL_QML_PREFIX=lib/qt6/qml \
    -DGIT_REVISION="tag-v$_ver"

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname-$_rev/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
