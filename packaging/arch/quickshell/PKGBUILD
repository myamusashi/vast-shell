pkgname=quickshell
pkgver=0.3.2
pkgrel=1
pkgdesc='Flexible QtQuick based desktop shell toolkit'
arch=(x86_64 aarch64)
url='https://quickshell.org'
license=('LGPL-3.0-only')
depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'qt6-svg'
  'cli11'
  'cpptrace'
  'jemalloc'
  'wayland'
  'wayland-protocols'
  'libdrm'
  'mesa' # libgbm / egl
  'libxcb'
  'pam'
  'pipewire'
  'glib2'
  'polkit'
)
makedepends=(
  'cmake'
  'ninja'
  'pkgconf'
  'qt6-shadertools'
  'spirv-tools'
  'vulkan-headers'
)
source=("$pkgname-$pkgver.tar.gz::https://git.outfoxxed.me/quickshell/quickshell/archive/v$pkgver.tar.gz")
sha256sums=('f14115a73c9fff6aa6399f924b632e88c3ce2cead2657f814a7825341f35baad')

build() {
  cmake -B build -S "$pkgname" -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DDISTRIBUTOR="archInstall" \
    -DINSTALL_QML_PREFIX=lib/qt6/qml \
    -DGIT_REVISION="tag-v$pkgver"

  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$pkgname/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
