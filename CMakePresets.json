{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "default",
      "displayName": "Default",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=mold"
      }
    },
    {
      "name": "clazy",
      "displayName": "Clazy static analysis",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_BUILD_TYPE": "Debug",
        "VAST_NO_PCH": "ON"
      }
    },
    {
      "name": "test",
      "displayName": "Unit tests",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/test",
      "cacheVariables": {
        "VAST_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "clazy",
      "configurePreset": "clazy",
      "targets": [
        "lint-clazy",
        "lint-tidy"
      ]
    },
    {
      "name": "test",
      "configurePreset": "test",
      "targets": [
        "tst_palette",
        "tst_colormaterial",
        "tst_spec_parity",
        "tst_quantizer_parity",
        "tst_fuzzy",
        "tst_search",
        "tst_clipboarddatabase",
        "tst_clipboardmodel",
        "tst_clipboardhelpers",
        "tst_clipboardmanager",
        "tst_audioprofiles",
        "tst_audiocards",
        "tst_audiodevices",
        "tst_brightnessstore",
        "tst_brightnessdisplay",
        "tst_brightnessmanager",
        "tst_imagecacheindex",
        "tst_imagecache",
        "tst_lrcparser",
        "tst_lyricscache",
        "tst_lyricsscheduler",
        "tst_keylock",
        "tst_colorutils",
        "tst_utilsfile",
        "tst_paletteanimator",
        "tst_translation",
        "tst_jobexecutor",
        "tst_bluetoothagent",
        "tst_kdeconnectshare"
      ]
    }
  ]
}
